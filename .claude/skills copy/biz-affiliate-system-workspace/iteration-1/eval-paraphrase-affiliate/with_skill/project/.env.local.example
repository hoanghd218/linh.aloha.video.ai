# SMTP transactional email (P3 pre-payment + P5 post-payment auto-responder)
# Provider-agnostic — Gmail / Resend SMTP / SendGrid / Brevo / Mailgun / Zoho / custom hosting VN
# SMTP_SECURE=false cho port 587 (STARTTLS), =true cho port 465 (SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ZALO_GROUP_LINK=
LANDING_PAGE_URL=https://theaifirst.vn

# Chatbot (OpenRouter) — gọi LLM cho widget tư vấn AI Agent Camp
# Lấy key tại https://openrouter.ai/keys (sign up bằng Google → Create Key → nạp credit)
# Default model: google/gemini-3-flash-preview (rẻ, ~$0.075/1M input)
# Đổi sang anthropic/claude-sonnet-4.6 trong src/app/api/chat/route.ts nếu muốn chất lượng cao hơn (~10x đắt)
